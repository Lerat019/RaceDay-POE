@model List<RaceDayMVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-action="Create" class="btn btn-success">+ Create New Event</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info text-center">
                    You haven't created any events yet. Click "Create New Event" to get started!
                </div>
            }
            else
            {
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.EventName</td>
                                <td>@ev.EventDate.ToShortDateString()</td>
                                <td>@ev.Location</td>
                                <td>@ev.EventType</td>
                                <td>
                                    <!-- New Categories Button -->
                                    <a asp-action="ManageCategories" asp-route-id="@ev.EventId" class="btn btn-sm btn-info text-white">Categories</a>
                                    <a asp-action="EnterResults" asp-route-id="@ev.EventId" class="btn btn-sm btn-warning text-dark">Results</a>

                                    <!-- Edit and Delete Buttons (Will work later) -->
                                    <button class="btn btn-sm btn-primary">Edit</button>
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>