@model List<RaceDayMVC.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var eventDetails = ViewBag.EventDetails as RaceDayMVC.ViewModels.EventViewModel;
    int eventId = ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Categories for: @eventDetails?.EventName</h2>
            <p class="text-muted">Add or view race categories for this event.</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <!-- List of existing categories -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Existing Categories</div>
                <div class="card-body">
                    @if (Model == null || Model.Count == 0)
                    {
                        <p>No categories created yet.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Distance</th>
                                    <th>Max Participants</th>
                                    <th>Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr>
                                        <td>@cat.CategoryName</td>
                                        <td>@cat.Distance km</td>
                                        <td>@cat.MaxParticipants</td>
                                        <td>R@(cat.EntryFee)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- Form to add a new category -->
        <div class="col-md-5">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">Add New Category</div>
                <div class="card-body">
                    <form asp-action="CreateCategory" method="post">
                        <input type="hidden" name="eventId" value="@eventId" />

                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="categoryName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Distance (km)</label>
                            <input type="number" step="0.1" name="distance" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Max Participants</label>
                            <input type="number" name="maxParticipants" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Entry Fee (R)</label>
                            <input type="number" step="0.01" name="entryFee" class="form-control" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">Add Category</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>