@model List<RaceDayMVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Upcoming Races</h2>
        <p class="text-muted">Find your next challenge and join the race!</p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center shadow-sm">
            There are no upcoming events available right now. Check back later!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        
                        <div class="bg-secondary text-white text-center py-4" style="border-radius: 0.5rem 0.5rem 0 0;">
                            <h5 class="m-0">@ev.EventType Event</h5>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@ev.EventName</h5>
                            <p class="card-text text-muted small">
                                <i class="bi bi-calendar-event"></i> @ev.EventDate.ToLongDateString() <br />
                                <i class="bi bi-geo-alt-fill"></i> @ev.Location
                            </p>
                            <p class="card-text">@ev.Description</p>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid">
                                
                                <a href="#" class="btn btn-outline-success">View Details & Enroll</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>