@model RaceDayMVC.ViewModels.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow border-0">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">@Model.Event.EventName</h3>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-muted mb-4">@Model.Event.EventType Event</h5>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Date:</strong> <br /> @Model.Event.EventDate.ToLongDateString()</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Location:</strong> <br /> @Model.Event.Location</p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6><strong>Description</strong></h6>
                        <p>@Model.Event.Description</p>
                    </div>

                    <hr />

                    <form asp-action="Enroll" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Select a Category to Enroll</label>
                            @if (Model.Categories.Count == 0)
                            {
                                <div class="alert alert-warning">No categories have been created for this event yet.</div>
                            }
                            else
                            {
                                <select name="selectedCategoryId" class="form-select form-select-lg mb-3" required>
                                    <option value="">-- Choose a Category --</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.CategoryId">
                                            @cat.CategoryName (@cat.Distance) - R@(cat.EntryFee)
                                        </option>
                                    }
                                </select>
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg">Enroll in this Event</button>
                                </div>
                            }
                        </div>
                    </form>

                    <div class="d-grid gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Events</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>