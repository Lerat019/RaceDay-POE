@model List<RaceDayMVC.ViewModels.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Race Results</h2>
        <a asp-action="Index" class="btn btn-outline-primary">Browse Events</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info text-center">
                    You don't have any race results yet. Keep training!
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td class="fw-bold">@result.EventName</td>
                                <td>@result.EventDate.ToShortDateString()</td>
                                <td>@result.CategoryName</td>
                                <td>
                                    @if (result.FinishTime.HasValue)
                                    {
                                        <span class="badge bg-primary fs-6">@result.FinishTime.Value.ToString(@"hh\:mm\:ss")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (result.Position.HasValue)
                                    {
                                        <span class="badge bg-success fs-6">@result.Position.Value</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>